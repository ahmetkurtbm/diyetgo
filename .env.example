# Bu dosyayı .env olarak kopyalayın ve parolayı değiştirin. .env Git'e eklenmez.
# Buradaki değerler örnektir; gerçek parola yazmayın.

# Docker Compose (PostgreSQL container'ı)
POSTGRES_USER=diyetgo
POSTGRES_PASSWORD=change-me
POSTGRES_DB=diyetgo

# Server (packages/server). Host portu docker-compose.yml ile aynı: 5433.
DATABASE_URL=postgres://diyetgo:change-me@localhost:5433/diyetgo
# Testler yalnızca bunu kullanır; veritabanı adı _test ile bitmelidir.
TEST_DATABASE_URL=postgres://diyetgo:change-me@localhost:5433/diyetgo_test
PORT=3001

# Kimlik doğrulama (Better Auth). Gizli anahtar en az 32 karakterlik rastgele bir değer olmalı:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=change-me-to-a-long-random-value-0123456789
# Uygulamanın tarayıcıda açıldığı adres (Vite geliştirme sunucusu /api isteklerini API'ye iletir).
BETTER_AUTH_URL=http://localhost:5173
# `npm run db:seed` ile oluşturulan demo diyetisyen hesabının (diyetisyen@example.com) parolası; en az 10 karakter.
SEED_DIETITIAN_PASSWORD=change-me-please
